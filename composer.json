{
    "name": "newbgp/pest-psr7-expectations",
    "description": "Pest expectations for PSR-7 HTTP responses",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Felipe Azambuja"
        }
    ],
    "require": {
        "php": "^8.1",
        "pestphp/pest": "^2.0 || ^3.0 || ^4.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/psr7": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "NewBGP\\PestPsr7\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
